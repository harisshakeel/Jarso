{
  "name": "jarso",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter @jarso/web",
    "mobile": "pnpm --filter @jarso/mobile start",
    "build:apk": "bash scripts/build-apk.sh",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @jarso/web test:e2e",
    "eval:guide": "pnpm --filter @jarso/web eval:guide",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:migration": "supabase migration new",
    "db:push": "supabase db push --linked",
    "db:revert": "sh scripts/db-revert.sh",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts",
    "db:types:linked": "supabase gen types typescript --linked > packages/db/src/database.types.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "husky": "^9.1.7",
    "supabase": "^2.122.0",
    "typescript": "^5",
    "turbo": "^2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
}
