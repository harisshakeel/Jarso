{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "lint": {},
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^typecheck"] },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "public/brand/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "dev": { "persistent": true, "cache": false },
    "test:e2e": { "cache": false },
    "eval:guide": { "cache": false }
  }
}
