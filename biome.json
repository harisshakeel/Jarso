{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/next-env.d.ts",
      "!pnpm-lock.yaml",
      "!packages/db/src/database.types.ts",
      "!supabase/.temp",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.md",
      "!apps/mobile/.expo",
      "!apps/mobile/ios",
      "!apps/mobile/android",
      "!apps/mobile/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "useExportType": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/core/**", "packages/content/**", "packages/data/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "Browser global not allowed in shared code.",
                  "document": "Browser global not allowed in shared code.",
                  "navigator": "Browser global not allowed in shared code.",
                  "localStorage": "Browser global not allowed in shared code.",
                  "sessionStorage": "Browser global not allowed in shared code.",
                  "indexedDB": "Browser global not allowed in shared code.",
                  "location": "Browser global not allowed in shared code."
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "core/content must stay framework-free.",
                  "react-dom": "core/content must stay framework-free.",
                  "server-only": "core/content must stay framework-free.",
                  "@supabase/ssr": "core/content must stay framework-free.",
                  "idb": "core/content must stay framework-free."
                },
                "patterns": [
                  {
                    "group": ["next", "next/**"],
                    "message": "No Next.js in shared code."
                  },
                  {
                    "group": ["@/**"],
                    "message": "No web app aliases in shared code."
                  },
                  {
                    "group": ["@jarso/brand", "@jarso/brand/**"],
                    "message": "No brand in shared code."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/lib/**", "packages/core/src/config/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "core/content must stay framework-free.",
                  "react-dom": "core/content must stay framework-free.",
                  "server-only": "core/content must stay framework-free.",
                  "@supabase/ssr": "core/content must stay framework-free.",
                  "idb": "core/content must stay framework-free."
                },
                "patterns": [
                  {
                    "group": ["next", "next/**"],
                    "message": "No Next.js in shared code."
                  },
                  {
                    "group": ["@/**"],
                    "message": "No web app aliases in shared code."
                  },
                  {
                    "group": ["@jarso/brand", "@jarso/brand/**"],
                    "message": "No brand in shared code."
                  },
                  {
                    "group": ["@jarso/core/**", "!@jarso/core/lib", "!@jarso/core/config"],
                    "message": "lib/config cannot import feature layers."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/{ledger,goals,rules,profiles,auth,payments,allowance}/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "core/content must stay framework-free.",
                  "react-dom": "core/content must stay framework-free.",
                  "server-only": "core/content must stay framework-free.",
                  "@supabase/ssr": "core/content must stay framework-free.",
                  "idb": "core/content must stay framework-free."
                },
                "patterns": [
                  {
                    "group": ["next", "next/**"],
                    "message": "No Next.js in shared code."
                  },
                  {
                    "group": ["@/**"],
                    "message": "No web app aliases in shared code."
                  },
                  {
                    "group": ["@jarso/brand", "@jarso/brand/**"],
                    "message": "No brand in shared code."
                  },
                  {
                    "group": [
                      "@jarso/core/learning",
                      "@jarso/core/learning/**",
                      "@jarso/core/diary",
                      "@jarso/core/diary/**",
                      "@jarso/core/requests",
                      "@jarso/core/requests/**",
                      "@jarso/core/family",
                      "@jarso/core/family/**",
                      "@jarso/core/notifications",
                      "@jarso/core/notifications/**",
                      "@jarso/core/guide",
                      "@jarso/core/guide/**",
                      "@jarso/core/review",
                      "@jarso/core/review/**",
                      "@jarso/core/offline",
                      "@jarso/core/offline/**"
                    ],
                    "message": "Leaf modules cannot import composite modules."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/global.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/{app,src}/**", "!apps/mobile/src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@jarso/core/lib": "Import from @/lib so the app logger is configured."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**", "!apps/web/src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@jarso/core/lib": "Import from @/lib so the web logger is configured."
                }
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
