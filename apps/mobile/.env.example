# Copy to apps/mobile/.env.local. Public values only: EXPO_PUBLIC_* is inlined into the app bundle.
# Hosted Supabase project URL and its publishable key (never the secret key).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The web app's base URL, reachable from the phone (laptop LAN address or a tunnel URL).
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
